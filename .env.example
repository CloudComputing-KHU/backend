# Cognito 인증
COGNITO_USER_POOL_ID = us-east-1_DXuWD2JlC
COGNITO_APP_CLIENT_ID = 41vuk69n7h7liovcv7efme8tr0

# AWS credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS region - Auth
AUTH_AWS_REGION=us-east-1

# AWS region - Data (S3 / DynamoDB)
DATA_AWS_REGION=ap-northeast-2

# DynamoDB region (기본값: AWS_REGION 또는 ap-northeast-2)
# DYNAMODB_REGION=ap-northeast-2

# S3 upload target
S3_BUCKET_NAME=cloud-compute-team-e
S3_VOICE_PREFIX=voices
S3_PHOTO_PREFIX=photos

# Response format preference
S3_URL_MODE=s3_uri

# OpenAI (Whisper STT)
OPENAI_API_KEY=your-openai-api-key

# Lambda + API Gateway for dementia analysis (OpenAI GPT)
# API Gateway 배포 후 발급된 URL을 설정
LLM_API_GATEWAY_URL=https://aauwtmiqkh.execute-api.us-east-1.amazonaws.com/prod/analyze

# DynamoDB 테이블 이름 (기본값 그대로 쓰면 아래 설정 불필요)
# DYNAMODB_USER_PROFILES_TABLE=user_profiles
# DYNAMODB_FAMILY_INVITES_TABLE=family_invites
# DYNAMODB_FAMILY_LINKS_TABLE=family_links
# DYNAMODB_ANSWERS_TABLE=answers
# DYNAMODB_PHOTOS_TABLE=photos
# DYNAMODB_PHOTO_REACTIONS_TABLE=photo_reactions
# DYNAMODB_DEMENTIA_ANALYSES_TABLE=dementia_assessments
# DYNAMODB_DEVICE_TOKENS_TABLE=device_tokens
# DYNAMODB_NOTIFICATIONS_TABLE=notifications
ALLOW_IN_MEMORY_FALLBACK=false

# Firebase Admin SDK (둘 중 하나만 설정)
# 방법 1: 서비스 계정 JSON 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# 방법 2: JSON 내용을 직접 문자열로 (컨테이너 환경 권장)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# E2E 테스트용 Cognito 계정 (선택 — 없으면 --email/--password 인자로 지정)
# TEST_EMAIL=test@example.com
# TEST_PASSWORD=TestPass123!
