# Cognito 인증
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS region - Auth
AUTH_AWS_REGION=us-east-1

# AWS region - Data (S3 / Transcribe / future DynamoDB)
DATA_AWS_REGION=ap-northeast-2

# S3 upload target
S3_BUCKET_NAME=cloud-compute-team-e
S3_VOICE_PREFIX=voices
S3_PHOTO_PREFIX=photos

# Response format preference
S3_URL_MODE=s3_uri

# Lambda + API Gateway for dementia analysis (OpenAI GPT)
# API Gateway 배포 후 발급된 URL을 설정
LLM_API_GATEWAY_URL=https://aauwtmiqkh.execute-api.us-east-1.amazonaws.com/prod/analyze

# Supabase (temporary relational persistence for family links / metadata)
# Project Settings -> API 에서 확인
# - Project URL
# - service_role key (백엔드 전용, FE에 노출 금지)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=public

# Optional table names (기본값으로 public 스키마에 생성할 예정)
SUPABASE_USER_PROFILES_TABLE=user_profiles
SUPABASE_FAMILY_INVITES_TABLE=family_invites
SUPABASE_FAMILY_LINKS_TABLE=family_links
SUPABASE_ANSWERS_TABLE=answers
SUPABASE_PHOTOS_TABLE=photos
SUPABASE_PHOTO_REACTIONS_TABLE=photo_reactions
SUPABASE_DEMENTIA_ANALYSES_TABLE=dementia_analyses
SUPABASE_DEVICE_TOKENS_TABLE=device_tokens
SUPABASE_NOTIFICATIONS_TABLE=notifications
ALLOW_IN_MEMORY_FALLBACK=false

# Firebase Admin SDK (둘 중 하나만 설정)
# 방법 1: 서비스 계정 JSON 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# 방법 2: JSON 내용을 직접 문자열로 (컨테이너 환경 권장)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
  
